# Copy to .env and adjust. All values are optional; defaults shown.
# docker-compose.yml overrides the host values so services find each other.

LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./app.db
UPLOAD_DIR=uploads

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3

CHUNK_SIZE=500
CHUNK_OVERLAP=50
PARAGRAPH_MAX_LENGTH=500

TOP_K=5
MAX_HISTORY_MESSAGES=6
