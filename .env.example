# Copy to .env and adjust. All values are optional; defaults shown.
# docker-compose.yml overrides the host values so services find each other.

LOG_LEVEL=INFO
# IANA time zone for booking dates/times ("now", "today", "tomorrow")
TIMEZONE=Asia/Kathmandu

DATABASE_URL=sqlite:///./app.db
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3

# Token counts (embedding model tokenizer); all-MiniLM-L6-v2 allows at most 254.
CHUNK_SIZE=200
CHUNK_OVERLAP=40

TOP_K=5
MAX_TOP_K=20
MIN_SIMILARITY_SCORE=0.25
SNIPPET_LENGTH=200

# History sent to the LLM / stored in Redis
MAX_HISTORY_MESSAGES=6
CHAT_HISTORY_TTL_SECONDS=86400
CHAT_HISTORY_MAX_MESSAGES=50
BOOKING_STATE_TTL_SECONDS=1800
